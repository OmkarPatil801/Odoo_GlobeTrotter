# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Comma-separated allowlist of origins allowed to call this API from a
# browser, e.g.:
#   CORS_ORIGIN=http://localhost:5173,https://app.globetrotter.example
# "*" (any origin) is a development-only convenience — production refuses
# to boot with CORS_ORIGIN=* (see src/config/env.js).
CORS_ORIGIN=http://localhost:5173

# Generate a real secret for local/dev use, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit an actual secret value. Production refuses to boot with a
# short/common secret (e.g. this placeholder) — see src/config/env.js.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# MySQL / Prisma. When unset (development/test only), the app falls back
# to in-memory repositories — the test suite never requires a live
# database. Production requires this to be set (see src/config/env.js).
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/globetrotter"

# --- Rate limiting (all optional — sane defaults if unset) ---
# General API limit (requests / IP / window):
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# Stricter limits for the auth endpoints most attractive to abuse:
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_LOGIN_MAX=10

# --- Request size limit (optional — defaults to 100kb) ---
# JSON_BODY_LIMIT=100kb
