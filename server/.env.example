# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# Generate a real secret for local/dev use, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit an actual secret value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# MySQL / Prisma. When unset, the app falls back to in-memory repositories
# (used automatically by the test suite — never require a live database).
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/globetrotter"
