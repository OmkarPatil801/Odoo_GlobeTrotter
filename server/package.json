{
  "name": "globetrotter-server",
  "version": "1.0.0",
  "description": "GlobeTrotter server - Express API backend + Prisma/MySQL database layer",
  "private": true,
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
